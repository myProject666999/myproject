{
  "name": "pet-grooming-saas",
  "version": "1.0.0",
  "description": "宠物美容洗护服务SaaS系统",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:backend": "npm run start:dev --workspace=backend",
