<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.emojipack.mapper.MaterialMapper">

    <resultMap id="MaterialResultMap" type="com.emojipack.entity.Material">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="description" property="description"/>
        <result column="category_id" property="categoryId"/>
        <result column="uploader_id" property="uploaderId"/>
        <result column="file_url" property="fileUrl"/>
        <result column="thumbnail_url" property="thumbnailUrl"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="width" property="width"/>
        <result column="height" property="height"/>
        <result column="is_copyright" property="isCopyright"/>
        <result column="download_limit" property="downloadLimit"/>
        <result column="download_count" property="downloadCount"/>
        <result column="favorite_count" property="favoriteCount"/>
        <result column="view_count" property="viewCount"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectPageWithDetail" resultMap="MaterialResultMap">
        SELECT DISTINCT m.* FROM material m
        <if test="tagId != null">
            INNER JOIN material_tag mt ON m.id = mt.material_id
        </if>
        <where>
            m.status = 1
            <if test="keyword != null and keyword != ''">
                AND (m.title LIKE CONCAT('%', #{keyword}, '%') OR m.description LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <if test="categoryId != null">
                AND m.category_id = #{categoryId}
            </if>
            <if test="tagId != null">
                AND mt.tag_id = #{tagId}
            </if>
            <if test="uploaderId != null">
                AND m.uploader_id = #{uploaderId}
            </if>
        </where>
        <choose>
            <when test="sort == 'download'">
                ORDER BY m.download_count DESC
            </when>
            <when test="sort == 'favorite'">
                ORDER BY m.favorite_count DESC
            </when>
            <when test="sort == 'view'">
                ORDER BY m.view_count DESC
            </when>
            <otherwise>
                ORDER BY m.create_time DESC
            </otherwise>
        </choose>
    </select>
</mapper>
