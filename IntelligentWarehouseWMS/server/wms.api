}

type (
	ProductInfo {
		Id          int64   `json:"id"`
		Sku         string  `json:"sku"`
		ProductName string  `json:"productName"`
		Category    string  `json:"category"`
		Spec        string  `json:"spec"`
		Unit        string  `json:"unit"`
		Weight      float64 `json:"weight"`
		Volume      float64 `json:"volume"`
		MinStock    int     `json:"minStock"`
		MaxStock    int     `json:"maxStock"`
		Status      int64   `json:"status"`
		Remark      string  `json:"remark"`
		CreateTime  string  `json:"createTime"`
	}

	ProductListReq {
		Page        int64  `form:"page"`
		PageSize    int64  `form:"pageSize"`
		Sku         string `form:"sku,optional"`
		ProductName string `form:"productName,optional"`
		Category    string `form:"category,optional"`
		Status      int64  `form:"status,optional"`
	}

	ProductListResp {
		Total int64         `json:"total"`
		List  []ProductInfo `json:"list"`
	}

	ProductCreateReq {
		Sku         string  `json:"sku"`
		ProductName string  `json:"productName"`
		Category    string  `json:"category"`
		Spec        string  `json:"spec"`
		Unit        string  `json:"unit"`
		Weight      float64 `json:"weight"`
		Volume      float64 `json:"volume"`
		MinStock    int     `json:"minStock"`
		MaxStock    int     `json:"maxStock"`
		Status      int64   `json:"status"`
		Remark      string  `json:"remark"`
	}

	ProductUpdateReq {
		Id          int64   `json:"id"`
		Sku         string  `json:"sku"`
		ProductName string  `json:"productName"`
		Category    string  `json:"category"`
		Spec        string  `json:"spec"`
		Unit        string  `json:"unit"`
		Weight      float64 `json:"weight"`
		Volume      float64 `json:"volume"`
		MinStock    int     `json:"minStock"`
		MaxStock    int     `json:"maxStock"`
		Status      int64   `json:"status"`
		Remark      string  `json:"remark"`
	}

	ProductDeleteReq {
		Id int64 `json:"id"`
	}
)

@server(
	prefix: /api/product
	group: product
)
service wms-api {
	@doc "获取货品列表"
	@handler productList
	get /list (ProductListReq) returns (ProductListResp)

	@doc "获取货品详情"
	@handler productDetail
	get /detail/:id returns (ProductInfo)

	@doc "创建货品"
	@handler productCreate
	post /create (ProductCreateReq) returns (CommonResp)

	@doc "更新货品"
	@handler productUpdate
	post /update (ProductUpdateReq) returns (CommonResp)

	@doc "删除货品"
	@handler productDelete
	post /delete (ProductDeleteReq) returns (CommonResp)
}

type (
	InventoryInfo {
		Id             int64   `json:"id"`
		WarehouseId    int64   `json:"warehouseId"`
		LocationId     int64   `json:"locationId"`
		ProductId      int64   `json:"productId"`
		Sku            string  `json:"sku"`
		Quantity       int64   `json:"quantity"`
		AvailableQty   int64   `json:"availableQty"`
		LockedQty      int64   `json:"lockedQty"`
		Version        int64   `json:"version"`
		BatchNo        string  `json:"batchNo"`
		ProductionDate string  `json:"productionDate"`
		ExpiryDate     string  `json:"expiryDate"`
		CreateTime     string  `json:"createTime"`
	}

	InventoryListReq {
		Page        int64  `form:"page"`
		PageSize    int64  `form:"pageSize"`
		WarehouseId int64  `form:"warehouseId,optional"`
		LocationId  int64  `form:"locationId,optional"`
		ProductId   int64  `form:"productId,optional"`
		Sku         string `form:"sku,optional"`
	}

	InventoryListResp {
		Total int64           `json:"total"`
		List  []InventoryInfo `json:"list"`
	}
)

@server(
	prefix: /api/inventory
	group: inventory
)
service wms-api {
	@doc "获取库存列表"
	@handler inventoryList
	get /list (InventoryListReq) returns (InventoryListResp)

	@doc "获取库存详情"
	@handler inventoryDetail
	get /detail/:id returns (InventoryInfo)
}

type (
	InboundOrderInfo {
		Id           int64  `json:"id"`
		OrderNo      string `json:"orderNo"`
		WarehouseId  int64  `json:"warehouseId"`
		OrderType    int64  `json:"orderType"`
		Supplier     string `json:"supplier"`
		TotalQty     int64  `json:"totalQty"`
		InboundQty   int64  `json:"inboundQty"`
		Status       int64  `json:"status"`
		Operator     string `json:"operator"`
		AuditTime    string `json:"auditTime"`
		CompleteTime string `json:"completeTime"`
		Remark       string `json:"remark"`
		CreateTime   string `json:"createTime"`
	}

	InboundOrderListReq {
		Page        int64  `form:"page"`
		PageSize    int64  `form:"pageSize"`
		WarehouseId int64  `form:"warehouseId,optional"`
		OrderType   int64  `form:"orderType,optional"`
		Status      int64  `form:"status,optional"`
		OrderNo     string `form:"orderNo,optional"`
		Supplier    string `form:"supplier,optional"`
	}

	InboundOrderListResp {
		Total int64               `json:"total"`
		List  []InboundOrderInfo  `json:"list"`
	}

	InboundOrderCreateReq {
		OrderNo     string `json:"orderNo"`
		WarehouseId int64  `json:"warehouseId"`
		OrderType   int64  `json:"orderType"`
		Supplier    string `json:"supplier"`
		TotalQty    int64  `json:"totalQty"`
		Status      int64  `json:"status"`
		Operator    string `json:"operator"`
		Remark      string `json:"remark"`
	}

	InboundOrderUpdateReq {
		Id          int64  `json:"id"`
		OrderNo     string `json:"orderNo"`
		WarehouseId int64  `json:"warehouseId"`
		OrderType   int64  `json:"orderType"`
		Supplier    string `json:"supplier"`
		TotalQty    int64  `json:"totalQty"`
		InboundQty  int64  `json:"inboundQty"`
		Status      int64  `json:"status"`
		Operator    string `json:"operator"`
		Remark      string `json:"remark"`
	}

	InboundOrderDeleteReq {
		Id int64 `json:"id"`
	}
)

@server(
	prefix: /api/inbound
	group: inbound
)
service wms-api {
	@doc "获取入库单列表"
	@handler inboundOrderList
	get /list (InboundOrderListReq) returns (InboundOrderListResp)

	@doc "获取入库单详情"
