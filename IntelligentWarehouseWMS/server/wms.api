syntax = "v1"

info(
	title: "WMS API"
	desc: "智能仓库管理系统API文档"
	author: "WMS Team"
	version: "1.0.0"
)

type (
	LoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}

	LoginResp {
		Token    string `json:"token"`
		UserId   int64  `json:"userId"`
		Username string `json:"username"`
		RealName string `json:"realName"`
		Role     string `json:"role"`
	}
)

@server(
	prefix: /api/auth
)
service wms-api {
	@doc "用户登录"
	@handler login
	post /login (LoginReq) returns (LoginResp)
}

type (
	UserInfo {
		Id         int64  `json:"id"`
		Username   string `json:"username"`
		RealName   string `json:"realName"`
		Phone      string `json:"phone"`
		Email      string `json:"email"`
		Role       string `json:"role"`
		Status     int64  `json:"status"`
		Remark     string `json:"remark"`
		CreateTime string `json:"createTime"`
	}

	UserListReq {
		Page     int64  `form:"page"`
		PageSize int64  `form:"pageSize"`
		Username string `form:"username,optional"`
		RealName string `form:"realName,optional"`
		Phone    string `form:"phone,optional"`
		Role     string `form:"role,optional"`
		Status   int64  `form:"status,optional"`
	}

	UserListResp {
		Total int64      `json:"total"`
		List  []UserInfo `json:"list"`
	}

	UserCreateReq {
		Username string `json:"username"`
		Password string `json:"password"`
		RealName string `json:"realName"`
		Phone    string `json:"phone"`
		Email    string `json:"email"`
		Role     string `json:"role"`
		Status   int64  `json:"status"`
		Remark   string `json:"remark"`
	}

	UserUpdateReq {
		Id       int64  `json:"id"`
		Username string `json:"username"`
		Password string `json:"password,optional"`
		RealName string `json:"realName"`
		Phone    string `json:"phone"`
		Email    string `json:"email"`
		Role     string `json:"role"`
		Status   int64  `json:"status"`
		Remark   string `json:"remark"`
	}

	UserDeleteReq {
		Id int64 `json:"id"`
	}

	CommonResp {
		Code    int    `json:"code"`
		Message string `json:"message"`
	}
)

@server(
	prefix: /api/user
	group: user
)
service wms-api {
	@doc "获取用户列表"
	@handler userList
	get /list (UserListReq) returns (UserListResp)

	@doc "获取用户详情"
	@handler userDetail
	get /detail/:id returns (UserInfo)

	@doc "创建用户"
	@handler userCreate
	post /create (UserCreateReq) returns (CommonResp)

	@doc "更新用户"
	@handler userUpdate
	post /update (UserUpdateReq) returns (CommonResp)

	@doc "删除用户"
	@handler userDelete
	post /delete (UserDeleteReq) returns (CommonResp)
}

type (
	WarehouseInfo {
		Id            int64  `json:"id"`
		WarehouseCode string `json:"warehouseCode"`
		WarehouseName string `json:"warehouseName"`
		Address       string `json:"address"`
		Manager       string `json:"manager"`
		Phone         string `json:"phone"`
		Status        int64  `json:"status"`
		Remark        string `json:"remark"`
		CreateTime    string `json:"createTime"`
	}

	WarehouseListReq {
		Page          int64  `form:"page"`
		PageSize      int64  `form:"pageSize"`
		WarehouseCode string `form:"warehouseCode,optional"`
		WarehouseName string `form:"warehouseName,optional"`
		Status        int64  `form:"status,optional"`
	}

	WarehouseListResp {
		Total int64           `json:"total"`
		List  []WarehouseInfo `json:"list"`
	}

	WarehouseCreateReq {
		WarehouseCode string `json:"warehouseCode"`
		WarehouseName string `json:"warehouseName"`
		Address       string `json:"address"`
		Manager       string `json:"manager"`
		Phone         string `json:"phone"`
		Status        int64  `json:"status"`
		Remark        string `json:"remark"`
	}

	WarehouseUpdateReq {
		Id            int64  `json:"id"`
		WarehouseCode string `json:"warehouseCode"`
		WarehouseName string `json:"warehouseName"`
		Address       string `json:"address"`
		Manager       string `json:"manager"`
		Phone         string `json:"phone"`
		Status        int64  `json:"status"`
		Remark        string `json:"remark"`
	}

	WarehouseDeleteReq {
		Id int64 `json:"id"`
	}
)

@server(
	prefix: /api/warehouse
	group: warehouse
)
service wms-api {
	@doc "获取仓库列表"
	@handler warehouseList
	get /list (WarehouseListReq) returns (WarehouseListResp)

	@doc "获取仓库详情"
	@handler warehouseDetail
	get /detail/:id returns (WarehouseInfo)

	@doc "创建仓库"
	@handler warehouseCreate
	post /create (WarehouseCreateReq) returns (CommonResp)

	@doc "更新仓库"
	@handler warehouseUpdate
	post /update (WarehouseUpdateReq) returns (CommonResp)

	@doc "删除仓库"
	@handler warehouseDelete
	post /delete (WarehouseDeleteReq) returns (CommonResp)
}

type (
	ShelfInfo {
		Id          int64  `json:"id"`
		WarehouseId int64  `json:"warehouseId"`
		ShelfCode   string `json:"shelfCode"`
		ShelfName   string `json:"shelfName"`
		Rows        int    `json:"rows"`
		Columns     int    `json:"columns"`
		Status      int64  `json:"status"`
		Remark      string `json:"remark"`
		CreateTime  string `json:"createTime"`
	}

	ShelfListReq {
		Page        int64  `form:"page"`
		PageSize    int64  `form:"pageSize"`
		WarehouseId int64  `form:"warehouseId,optional"`
		ShelfCode   string `form:"shelfCode,optional"`
		ShelfName   string `form:"shelfName,optional"`
		Status      int64  `form:"status,optional"`
	}

	ShelfListResp {
		Total int64       `json:"total"`
		List  []ShelfInfo `json:"list"`
	}

	ShelfCreateReq {
		WarehouseId int64  `json:"warehouseId"`
		ShelfCode   string `json:"shelfCode"`
		ShelfName   string `json:"shelfName"`
		Rows        int    `json:"rows"`
		Columns     int    `json:"columns"`
		Status      int64  `json:"status"`
		Remark      string `json:"remark"`
	}

	ShelfUpdateReq {
		Id          int64  `json:"id"`
		WarehouseId int64  `json:"warehouseId"`
		ShelfCode   string `json:"shelfCode"`
		ShelfName   string `json:"shelfName"`
		Rows        int    `json:"rows"`
		Columns     int    `json:"columns"`
		Status      int64  `json:"status"`
		Remark      string `json:"remark"`
	}

	ShelfDeleteReq {
		Id int64 `json:"id"`
	}
)

@server(
	prefix: /api/shelf
	group: shelf
)
service wms-api {
	@doc "获取货架列表"
	@handler shelfList
	get /list (ShelfListReq) returns (ShelfListResp)

	@doc "获取货架详情"
	@handler shelfDetail
	get /detail/:id returns (ShelfInfo)

	@doc "创建货架"
	@handler shelfCreate
	post /create (ShelfCreateReq) returns (CommonResp)

	@doc "更新货架"
	@handler shelfUpdate
	post /update (ShelfUpdateReq) returns (CommonResp)

	@doc "删除货架"
	@handler shelfDelete
	post /delete (ShelfDeleteReq) returns (CommonResp)
}

type (
	LocationInfo {
		Id           int64  `json:"id"`
		WarehouseId  int64  `json:"warehouseId"`
		ShelfId      int64  `json:"shelfId"`
		LocationCode string `json:"locationCode"`
		RowNo        int    `json:"rowNo"`
		ColNo        int    `json:"colNo"`
		Capacity     int    `json:"capacity"`
		UsedCapacity int    `json:"usedCapacity"`
		Status       int64  `json:"status"`
		Remark       string `json:"remark"`
		CreateTime   string `json:"createTime"`
	}

	LocationListReq {
		Page         int64  `form:"page"`
		PageSize     int64  `form:"pageSize"`
		WarehouseId  int64  `form:"warehouseId,optional"`
		ShelfId      int64  `form:"shelfId,optional"`
		LocationCode string `form:"locationCode,optional"`
		Status       int64  `form:"status,optional"`
	}

	LocationListResp {
		Total int64          `json:"total"`
		List  []LocationInfo `json:"list"`
	}

	LocationCreateReq {
		WarehouseId  int64  `json:"warehouseId"`
		ShelfId      int64  `json:"shelfId"`
		LocationCode string `json:"locationCode"`
		RowNo        int    `json:"rowNo"`
		ColNo        int    `json:"colNo"`
		Capacity     int    `json:"capacity"`
		UsedCapacity int    `json:"usedCapacity"`
		Status       int64  `json:"status"`
		Remark       string `json:"remark"`
	}

	LocationUpdateReq {
		Id           int64  `json:"id"`
		WarehouseId  int64  `json:"warehouseId"`
		ShelfId      int64  `json:"shelfId"`
		LocationCode string `json:"locationCode"`
		RowNo        int    `json:"rowNo"`
		ColNo        int    `json:"colNo"`
		Capacity     int    `json:"capacity"`
		UsedCapacity int    `json:"usedCapacity"`
		Status       int64  `json:"status"`
		Remark       string `json:"remark"`
	}

	LocationDeleteReq {
		Id int64 `json:"id"`
	}
)

@server(
	prefix: /api/location
	group: location
)
service wms-api {
	@doc "获取库位列表"
	@handler locationList
	get /list (LocationListReq) returns (LocationListResp)

	@doc "获取库位详情"
	@handler locationDetail
	get /detail/:id returns (LocationInfo)

	@doc "创建库位"
	@handler locationCreate
