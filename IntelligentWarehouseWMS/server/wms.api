type (
	StocktakeTaskInfo {
		Id          int64  `json:"id"`
		TaskNo      string `json:"taskNo"`
		WarehouseId int64  `json:"warehouseId"`
		TaskName    string `json:"taskName"`
		TaskType    int64  `json:"taskType"`
		TotalSku    int64  `json:"totalSku"`
		CheckedSku  int64  `json:"checkedSku"`
		Status      int64  `json:"status"`
		Operator    string `json:"operator"`
		StartTime   string `json:"startTime"`
		EndTime     string `json:"endTime"`
		Remark      string `json:"remark"`
		CreateTime  string `json:"createTime"`
	}

	StocktakeTaskListReq {
		Page        int64  `form:"page"`
		PageSize    int64  `form:"pageSize"`
		TaskNo      string `form:"taskNo,optional"`
		TaskName    string `form:"taskName,optional"`
		WarehouseId int64  `form:"warehouseId,optional"`
		TaskType    int64  `form:"taskType,optional"`
		Status      int64  `form:"status,optional"`
		Operator    string `form:"operator,optional"`
	}

	StocktakeTaskListResp {
		Total int64                `json:"total"`
		List  []StocktakeTaskInfo  `json:"list"`
	}

	StocktakeTaskCreateReq {
		TaskNo      string `json:"taskNo"`
		WarehouseId int64  `json:"warehouseId"`
		TaskName    string `json:"taskName"`
		TaskType    int64  `json:"taskType"`
		TotalSku    int64  `json:"totalSku"`
		Status      int64  `json:"status"`
		Operator    string `json:"operator"`
		Remark      string `json:"remark"`
	}

	StocktakeTaskUpdateReq {
		Id          int64  `json:"id"`
		TaskNo      string `json:"taskNo"`
		WarehouseId int64  `json:"warehouseId"`
		TaskName    string `json:"taskName"`
		TaskType    int64  `json:"taskType"`
		TotalSku    int64  `json:"totalSku"`
		CheckedSku  int64  `json:"checkedSku"`
		Status      int64  `json:"status"`
		Operator    string `json:"operator"`
		Remark      string `json:"remark"`
	}

	StocktakeTaskDeleteReq {
		Id int64 `json:"id"`
	}
)

@server(
	prefix: /api/stocktake
	group: stocktake
)
service wms-api {
	@doc "获取盘点任务列表"
	@handler stocktakeTaskList
	get /list (StocktakeTaskListReq) returns (StocktakeTaskListResp)

	@doc "获取盘点任务详情"
	@handler stocktakeTaskDetail
	get /detail/:id returns (StocktakeTaskInfo)

	@doc "创建盘点任务"
	@handler stocktakeTaskCreate
	post /create (StocktakeTaskCreateReq) returns (CommonResp)

	@doc "更新盘点任务"
	@handler stocktakeTaskUpdate
	post /update (StocktakeTaskUpdateReq) returns (CommonResp)

	@doc "删除盘点任务"
	@handler stocktakeTaskDelete
	post /delete (StocktakeTaskDeleteReq) returns (CommonResp)
}

type (
	DashboardResp {
		TotalWarehouse int64 `json:"totalWarehouse"`
		TotalProduct   int64 `json:"totalProduct"`
		TotalInventory int64 `json:"totalInventory"`
		InboundCount   int64 `json:"inboundCount"`
		OutboundCount  int64 `json:"outboundCount"`
		PendingTask    int64 `json:"pendingTask"`
	}

	InventoryReportReq {
		WarehouseId int64  `form:"warehouseId,optional"`
		Sku         string `form:"sku,optional"`
	}

	InventoryReportResp {
		TotalSku      int64 `json:"totalSku"`
		TotalQuantity int64 `json:"totalQuantity"`
		LowStockCount int64 `json:"lowStockCount"`
		OverStockCount int64 `json:"overStockCount"`
	}

	InOutReportReq {
		StartDate string `form:"startDate"`
		EndDate   string `form:"endDate"`
	}

	InOutReportItem {
		Date        string `json:"date"`
		InboundQty  int64  `json:"inboundQty"`
		OutboundQty int64  `json:"outboundQty"`
	}

	InOutReportResp {
		TotalInbound  int64            `json:"totalInbound"`
		TotalOutbound int64            `json:"totalOutbound"`
		List          []InOutReportItem `json:"list"`
	}
)

@server(
	prefix: /api/report
	group: report
)
service wms-api {
	@doc "仪表盘数据"
	@handler dashboard
	get /dashboard returns (DashboardResp)

	@doc "库存报表"
	@handler inventoryReport
	get /inventory (InventoryReportReq) returns (InventoryReportResp)

	@doc "出入库报表"
	@handler inOutReport
	get /inout (InOutReportReq) returns (InOutReportResp)
}
